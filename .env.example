# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=

# MongoDB Atlas Primary Operational Store
MONGODB_URI=
MONGODB_DATABASE=predictpro

# Neon PostgreSQL Secondary / Automatic Failover Store
NEON_DATABASE_URL=

# Upstash Redis (Cache / Feed Acceleration)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare R2 Historical / Analytics Store
R2_ACCOUNT_ID=
R2_BUCKET=predictpro-datasets
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# Admin API Key for administrative triggers
ADMIN_API_KEY=

# SportsSkills Provider Configuration
SPORTS_SKILLS_TIMEOUT_MS=5000
SPORTS_SKILLS_BASE_URL=https://api.sportsskills.io/v1
